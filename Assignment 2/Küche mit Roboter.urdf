<?xml version='1.0'?>
<robot name="domestic_assistant">
  <link name="room_link" />
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.25" length="0.3" />
      </geometry>
      <material name="base_link_mat">
        <color rgba="0.4 0.4 0.45 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.25" length="0.3" />
      </geometry>
    </collision>
    <inertial>
      <mass value="20" />
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5" />
    </inertial>
  </link>
  <joint name="room_to_base" type="fixed">
    <parent link="room_link" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="base_top" />
  <joint name="base_top_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_top" />
    <origin xyz="0 0 0.3" rpy="0 0 0" />
  </joint>
  <!-- ARM: joint 1 waist (yaw) / link 1 column -->
  <joint name="waist_joint" type="revolute">
    <parent link="base_top" />
    <child link="link1" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="1" />
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.3" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.6" />
      </geometry>
      <material name="link1_mat">
        <color rgba="0.95 0.5 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.3" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.6" />
      </geometry>
    </collision>
    <inertial>
      <mass value="2" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <!-- Schulter vom Arm -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0 0 0.6" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.4" upper="1.4" effort="80" velocity="1" />
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="0.3 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.04" length="0.6" />
      </geometry>
      <material name="link2_mat">
        <color rgba="0.95 0.5 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.3 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.04" length="0.6" />
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <!-- Handgelenkt -->
  <joint name="wrist_joint" type="revolute">
    <parent link="link2" />
    <child link="link3" />
    <origin xyz="0.6 0 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-2.2" upper="2.2" effort="30" velocity="1.5" />
  </joint>
  <link name="link3">
    <visual>
      <origin xyz="0.04 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.032" length="0.08" />
      </geometry>
      <material name="link3_mat">
        <color rgba="0.25 0.25 0.25 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.032" length="0.08" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002" />
    </inertial>
  </link>
  <link name="arm_tip" />
  <joint name="arm_tip_joint" type="fixed">
    <parent link="link3" />
    <child link="arm_tip" />
    <origin xyz="0.08 0 0" rpy="0 0 0" />
  </joint>
  <!-- Griff und Finger -->
  <link name="gripper_palm">
    <visual>
      <origin xyz="0.03 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.18 0.06" />
      </geometry>
      <material name="gripper_palm_mat">
        <color rgba="0.2 0.2 0.25 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.03 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.18 0.06" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002" />
    </inertial>
  </link>
  <joint name="gripper_mount_joint" type="fixed">
    <parent link="arm_tip" />
    <child link="gripper_palm" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="left_finger">
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.02 0.04" />
      </geometry>
      <material name="left_finger_mat">
        <color rgba="0.8 0.8 0.85 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.02 0.04" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005" />
    </inertial>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_palm" />
    <child link="left_finger" />
    <origin xyz="0.06 0.01 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.07" effort="20" velocity="0.1" />
  </joint>
  <link name="right_finger">
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.02 0.04" />
      </geometry>
      <material name="right_finger_mat">
        <color rgba="0.8 0.8 0.85 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.02 0.04" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005" />
    </inertial>
  </link>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_palm" />
    <child link="right_finger" />
    <origin xyz="0.06 -0.01 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.07" effort="20" velocity="0.1" />
    <mimic joint="left_finger_joint" multiplier="1" offset="0" />
  
  </joint>
  <!-- Küche: Kühlschrank -->
  <link name="fridge_body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.7 0.8 1.8" />
      </geometry>
      <material name="fridge_body_mat">
        <color rgba="0.9 0.9 0.95 0.35" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.7 0.8 1.8" />
      </geometry>
    </collision>
  </link>
  <joint name="room_link_to_fridge_body" type="fixed">
    <parent link="room_link" />
    <child link="fridge_body" />
    <origin xyz="-0.75 0.3 0.9" rpy="0 0 0" />
  </joint>
  <link name="fridge_door">
    <visual>
      <origin xyz="0.025 -0.4 0.65" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.8 1.3" />
      </geometry>
      <material name="fridge_door_mat">
        <color rgba="0.85 0.85 0.9 0.6" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.025 -0.4 0.65" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.8 1.3" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
  </link>
  <joint name="fridge_door_joint" type="revolute">
    <parent link="room_link" />
    <child link="fridge_door" />
    <origin xyz="-0.4 0.7 0" rpy="0 0 1.5708" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="0.5" effort="10" velocity="1" />
  </joint>
  <link name="shelf_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.7 0.02" />
      </geometry>
      <material name="shelf_1_mat">
        <color rgba="0.6 0.6 0.7 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.7 0.02" />
      </geometry>
    </collision>
  </link>
  <joint name="fridge_door_to_shelf_1" type="fixed">
    <parent link="fridge_door" />
    <child link="shelf_1" />
    <origin xyz="-0.075 -0.4 0.39" rpy="0 0 0" />
  </joint>
  <link name="shelf_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.7 0.02" />
      </geometry>
      <material name="shelf_2_mat">
        <color rgba="0.6 0.6 0.7 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.7 0.02" />
      </geometry>
    </collision>
  </link>
  <joint name="fridge_door_to_shelf_2" type="fixed">
    <parent link="fridge_door" />
    <child link="shelf_2" />
    <origin xyz="-0.075 -0.4 0.79" rpy="0 0 0" />
  </joint>
  <link name="shelf_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.7 0.02" />
      </geometry>
      <material name="shelf_3_mat">
        <color rgba="0.6 0.6 0.7 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.7 0.02" />
      </geometry>
    </collision>
  </link>
  <joint name="fridge_door_to_shelf_3" type="fixed">
    <parent link="fridge_door" />
    <child link="shelf_3" />
    <origin xyz="-0.075 -0.4 1.19" rpy="0 0 0" />
  </joint>
  <link name="milk_carton">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.2" />
      </geometry>
      <material name="milk_carton_mat">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.2" />
      </geometry>
    </collision>
  </link>
  <joint name="fridge_door_to_milk_carton" type="fixed">
    <parent link="fridge_door" />
    <child link="milk_carton" />
    <origin xyz="-0.075 -0.4 0.5" rpy="0 0 0" />
  </joint>
  <!-- Blauer Becher und Ablage -->
  <link name="counter">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="1 0.6 0.9" />
      </geometry>
      <material name="counter_mat">
        <color rgba="0.55 0.4 0.3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="1 0.6 0.9" />
      </geometry>
    </collision>
  </link>
  <joint name="room_link_to_counter" type="fixed">
    <parent link="room_link" />
    <child link="counter" />
    <origin xyz="0 -0.7 0.45" rpy="0 0 0" />
  </joint>
  <link name="eva_mug">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.08" length="0.12" />
      </geometry>
      <material name="eva_mug_mat">
        <color rgba="0.2 0.4 0.9 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.08" length="0.12" />
      </geometry>
    </collision>
  </link>
  <joint name="room_link_to_eva_mug" type="fixed">
    <parent link="room_link" />
    <child link="eva_mug" />
    <origin xyz="0 -0.7 0.96" rpy="0 0 0" />
  </joint>
</robot>